#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#include "spectral.glsl"
#include "common.glsl"

// prism.rgen — camera pass, DETERMINISTIC Whitted-style spectral shading.
//
// No Monte Carlo: a fixed rotating set of wavelengths (golden-ratio shift per
// frame) instead of a random lambda, Fresnel evaluated as weights on both
// branches instead of a coin flip, interleaved-gradient-noise dither instead
// of white noise. A single frame is already clean; accumulation only smooths
// the spectral band rotation and the fog dither.
//
// The fog march READS the photon grid filled by photon.rgen — zero rays per
// step. The rainbow fan and the floor caustic come from forward transport.

layout(binding = 0, set = 0) uniform accelerationStructureEXT tlas;
layout(binding = 1, set = 0, rgba32f) uniform image2D accumImage;

layout(location = 0) rayPayloadEXT Payload pay;

const int   N_LAMBDA   = 6;
const int   CHAIN_MAX  = 8;
const int   FOG_STEPS  = 20;
const float FOG_ATT_CAP = 8.0;
const float PHASE_ISO  = 0.07957747;      // 1 / (4*pi)
const vec3  MARCH_C    = vec3(0.0, 0.1, 0.0);
const float MARCH_R    = 2.9;

float lambdas[N_LAMBDA];
vec3  cieW[N_LAMBDA];

// interleaved gradient noise, animated over frames (deterministic dither)
float ign(uvec2 px, uint frame) {
    float x = float(px.x) + 5.588238 * float(frame & 63u);
    float y = float(px.y) + 3.4127   * float(frame & 63u);
    return fract(52.9829189 * fract(0.06711056 * x + 0.00583715 * y));
}

void traceThin(vec3 o, vec3 d) {
    pay.hitT = 1e30; pay.inst = 0xFFFFFFFFu;
    traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, o, 1e-4, d, 1e4, 0);
}

// ---- photon storage sampling (normalized by accumulated frame count) ----
vec3 gridSample(vec3 p) {
    vec3 f = (p - GRID_MIN) / GRID_H - 0.5;
    ivec3 c0 = ivec3(floor(f));
    vec3 t = f - vec3(c0);
    vec3 acc = vec3(0.0);
    for (int dz = 0; dz <= 1; ++dz)
    for (int dy = 0; dy <= 1; ++dy)
    for (int dx = 0; dx <= 1; ++dx) {
        ivec3 c = c0 + ivec3(dx, dy, dz);
        if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, ivec3(GX, GY, GZ))))
            continue;
        float w = (dx == 1 ? t.x : 1.0 - t.x)
                * (dy == 1 ? t.y : 1.0 - t.y)
                * (dz == 1 ? t.z : 1.0 - t.z);
        uint o = ((uint(c.z) * uint(GY) + uint(c.y)) * uint(GX) + uint(c.x)) * 3u;
        acc += vec3(float(fogGrid[o]), float(fogGrid[o + 1u]), float(fogGrid[o + 2u])) * w;
    }
    return acc / (FP_SCALE * float(U_FRAME + 1u));
}
vec3 causticSample(vec3 p) {
    vec2 f = (p.xz - vec2(CAUS_MIN)) / (CAUS_MAX - CAUS_MIN) * vec2(CX, CZ) - 0.5;
    ivec2 c0 = ivec2(floor(f));
    vec2 t = f - vec2(c0);
    vec3 acc = vec3(0.0);
    for (int dz = 0; dz <= 1; ++dz)
    for (int dx = 0; dx <= 1; ++dx) {
        ivec2 c = c0 + ivec2(dx, dz);
        if (any(lessThan(c, ivec2(0))) || any(greaterThanEqual(c, ivec2(CX, CZ))))
            continue;
        float w = (dx == 1 ? t.x : 1.0 - t.x) * (dz == 1 ? t.y : 1.0 - t.y);
        uint o = (uint(c.y) * uint(CX) + uint(c.x)) * 3u;
        acc += vec3(float(causMap[o]), float(causMap[o + 1u]), float(causMap[o + 2u])) * w;
    }
    return acc / (FP_SCALE * float(U_FRAME + 1u));
}

// Hue-preserving soft knee for the caustic shading term. The beam intensity
// is tuned for fog inscatter (where it is multiplied by sigma*phase*dt), so
// the raw floor irradiance is ~1e4 x the display range — per-channel clipping
// posterized the rainbow into blocks. Compress luminance, keep chromaticity.
// NB: shading works in integrated-XYZ units (flat white = CIE_Y_INTEGRAL);
// the display divide happens in resolve, so the knee lives in those units.
const float CAUS_KNEE = 1.5 * CIE_Y_INTEGRAL;
vec3 causticTerm(vec3 p) {
    vec3 c = causticSample(p);
    // knee on the MAX component: near the spectral locus (violet) Y is almost
    // zero while X and Z are huge — a luminance knee lets them through and
    // the channels clip into magenta, a color a rainbow cannot contain.
    float M = max(c.x, max(c.y, c.z)) * (1.0 / 3.14159265);
    if (M <= 1e-6) return vec3(0.0);
    float Mc = M / (1.0 + M / CAUS_KNEE);
    return c * (Mc / (M * 3.14159265));
}

// ---- environment / materials ----
vec3 skyXYZ(vec3 d) {
    vec3 env;
    if (d.y >= 0.0) {
        float up = pow(clamp(d.y, 0.0, 1.0), 0.6);
        env = mix(XYZ_HORIZON, XYZ_ZENITH, up);
    } else {
        env = mix(XYZ_HORIZON, XYZ_BELOW, smoothstep(0.0, 0.2, -d.y));
    }
    return env + XYZ_WHITE * (SUN_RADIANCE * smoothstep(SUN_COS_OUT, SUN_COS_IN, dot(d, SUN_DIR)));
}
float skySpectral(vec3 d, float lambda) {
    float bw = blueW(lambda);
    float horizon = 0.80 + 0.10 * bw;
    float env;
    if (d.y >= 0.0) {
        float up = pow(clamp(d.y, 0.0, 1.0), 0.6);
        env = mix(horizon, 0.30 + 0.45 * bw, up);
    } else {
        env = mix(horizon, 0.35, smoothstep(0.0, 0.2, -d.y));
    }
    return env + SUN_RADIANCE * smoothstep(SUN_COS_OUT, SUN_COS_IN, dot(d, SUN_DIR));
}
vec3 tileR(vec3 p) {
    float cx = floor(p.x / 0.5), cz = floor(p.z / 0.5);
    return (mod(cx + cz, 2.0) < 1.0) ? R_TILE_A : R_TILE_B;
}
float tileRSpectral(vec3 p, float lambda) {
    float cx = floor(p.x / 0.5), cz = floor(p.z / 0.5);
    return (mod(cx + cz, 2.0) < 1.0) ? 0.85 : (0.42 + 0.30 * blueW(lambda));
}
float ambSpectral(float lambda) { return 0.52 + 0.22 * blueW(lambda); }

// sun shadow: straight through glass with fixed attenuation, deterministic
float sunVisibility(vec3 P) {
    vec3 o = P;
    float w = 1.0;
    for (int b = 0; b < 4; ++b) {
        traceThin(o, SUN_DIR);
        if (pay.inst == 0xFFFFFFFFu) return w;               // reached the sky
        if (pay.inst == 1u) return 0.0;                      // floor blocks
        vec3 P2 = o + SUN_DIR * (pay.hitT + 1e-4);
        if (pay.inst == 0u) w *= 0.90;                       // glass: pass, dim
        o = P2;
    }
    return w;
}

// spectral transmission chain through the prism starting at a known interface
float glassChain(vec3 hitP, vec3 I, vec3 Ng, float lambda) {
    float nG = glassN(lambda);
    vec3 d; float omf;
    if (!refractAt(I, Ng, nG, d, omf)) return 0.0;           // safety
    float w = omf;
    vec3 o = hitP + d * 1e-4;
    for (int b = 0; b < CHAIN_MAX; ++b) {
        traceThin(o, d);
        if (pay.inst == 0xFFFFFFFFu) return w * skySpectral(d, lambda);
        vec3 P = o + d * pay.hitT;
        if (pay.inst == 2u) {                                // source quad
            float e = diskEmit(P, d);
            if (e > 0.0) return w * e * U_INTENSITY;
            o = P + d * 1e-4;                                // transparent border
            continue;
        }
        if (pay.inst == 1u) {                                // floor terminal
            float alb = tileRSpectral(P, lambda);
            float V = sunVisibility(P + vec3(0.0, 1e-4, 0.0));
            float caus = causticTerm(P).y;
            return w * alb * (SUN_E * V * SUN_DIR.y / 3.14159265
                              + 0.9 * ambSpectral(lambda) + caus);
        }
        vec3 nd; float t;                                    // prism interface
        vec3 Nh = pay.N;
        if (refractAt(d, Nh, nG, nd, t)) { w *= t; d = nd; }
        else {                                               // TIR
            vec3 N = (dot(d, Nh) > 0.0) ? -Nh : Nh;
            d = normalize(reflect(d, N));
        }
        o = P + d * 1e-4;
    }
    return 0.35 * w;                                         // depth exhausted
}

void main() {
    uvec2 px = gl_LaunchIDEXT.xy;
    uint frame = U_FRAME;

    float rot = fract(float(frame) * 0.6180339887);
    float dL = (LAMBDA_MAX - LAMBDA_MIN) / float(N_LAMBDA);
    for (int i = 0; i < N_LAMBDA; ++i) {
        lambdas[i] = LAMBDA_MIN + (float(i) + rot) * dL;
        cieW[i] = cieXYZ(lambdas[i]) * dL;
    }

    float dith = ign(px, frame);
    vec2 uv = (vec2(px) + vec2(dith, fract(dith + 0.5))) / vec2(U_DIMS);
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 pNear = ubo.invViewProj * vec4(ndc, 0.0, 1.0);
    vec4 pFar  = ubo.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 o   = pNear.xyz / pNear.w;
    vec3 dir = normalize(pFar.xyz / pFar.w - o);

    float sigma = U_FOG_SIGMA;
    uint  maxDepth = U_MAXDEPTH;

    vec3  L = vec3(0.0);          // accumulated XYZ
    float Wt = 1.0;               // achromatic walker weight
    float airDist = 0.0;

    for (uint dep = 0u; dep < maxDepth; ++dep) {
        traceThin(o, dir);
        bool hit = (pay.inst != 0xFFFFFFFFu);
        float hitT = pay.hitT;
        uint  inst = pay.inst;
        vec3  Nh   = pay.N;
        float segA = min(hitT, FOG_ATT_CAP);

        if (sigma > 0.0) {        // walker segments are all in air
            // clip the march to the sphere around the scene
            vec3 oc = o - MARCH_C;
            float bq = dot(oc, dir), cq = dot(oc, oc) - MARCH_R * MARCH_R;
            float disc = bq * bq - cq;
            if (disc > 0.0) {
                float sq = sqrt(disc);
                float t0 = max(-bq - sq, 0.0);
                float t1 = min(-bq + sq, hitT);
                if (t1 > t0) {
                    float dt = (t1 - t0) / float(FOG_STEPS);
                    for (int j = 0; j < FOG_STEPS; ++j) {
                        float tj = t0 + (float(j) + dith) * dt;
                        vec3 dens = gridSample(o + dir * tj);   // photon density
                        float att = Wt * exp(-sigma * (airDist + tj))
                                  * sigma * PHASE_ISO * dt;
                        L += dens * att;
                    }
                }
            }
            L += XYZ_AMB * (Wt * exp(-sigma * airDist) * (1.0 - exp(-sigma * segA)));
        }
        float Tr = exp(-sigma * (airDist + segA));

        if (!hit) { L += skyXYZ(dir) * (Wt * Tr); break; }
        vec3 P = o + dir * hitT;

        if (inst == 2u) {                    // source quad
            float e = diskEmit(P, dir);
            if (e > 0.0) { L += XYZ_WHITE * (Wt * Tr * e * U_INTENSITY); break; }
            o = P + dir * 1e-4;              // transparent border, same direction
            airDist += segA;
            continue;
        }
        if (inst == 1u) {                    // floor: diffuse + mirror branch
            vec3 R = tileR(P);
            float ndoti = clamp(-dir.y, 0.0, 1.0);
            float F = 0.05 + 0.95 * pow(1.0 - ndoti, 5.0);
            float V = sunVisibility(P + vec3(0.0, 1e-4, 0.0));
            vec3 diff = R * (XYZ_WHITE * (SUN_E * V * SUN_DIR.y / 3.14159265)
                             + XYZ_AMB * 0.9
                             + causticTerm(P));
            L += diff * (Wt * Tr * (1.0 - F));
            Wt *= F;                         // deterministic mirror branch
            if (Wt < 0.003) break;
            dir = normalize(reflect(dir, vec3(0.0, 1.0, 0.0)));
            o = P + dir * 1e-4;
            airDist += segA;
            continue;
        }
        // prism: spectral transmission chains + achromatic mirror walker
        {
            float n550 = glassN(550.0);
            vec3 N = (dot(dir, Nh) > 0.0) ? -Nh : Nh;
            float cosi = clamp(-dot(dir, N), 0.0, 1.0);
            float k = 1.0 - (1.0 / (n550 * n550)) * (1.0 - cosi * cosi);
            float F0 = (k < 0.0) ? 1.0
                     : fresnelDielectric(1.0, n550, cosi, sqrt(k));
            for (int i = 0; i < N_LAMBDA; ++i) {
                float s = glassChain(P, dir, Nh, lambdas[i]);
                if (s > 0.0) L += cieW[i] * (Wt * Tr * s);
            }
            Wt *= F0;                        // surface reflection continues
            if (Wt < 0.003) break;
            dir = normalize(reflect(dir, N));
            o = P + dir * 1e-4;
            airDist += segA;
            continue;
        }
    }

    vec4 prev = (frame == 0u) ? vec4(0.0) : imageLoad(accumImage, ivec2(px));
    imageStore(accumImage, ivec2(px), prev + vec4(L, 1.0));
}
